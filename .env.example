# Copy to .env; never commit .env.
NCBI_EMAIL=your-email@example.com
NCBI_API_KEY=
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=600
PHYLOGPT_PORT=8501
# Docker Compose overrides the URL and paths automatically.
OLLAMA_URL=http://localhost:11434
PHYLOGPT_TOOL_PATH=
PHYLOGPT_DATASETS_BIN=datasets
PHYLOGPT_MAFFT_BIN=mafft
PHYLOGPT_RAXML_BIN=raxml-ng
